{
  "manifest_version": 3,
  "name": "Intentio",
  "version": "0.1.0",
  "description": "ADHD focus tool — interrupt before distraction.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback",
    "storage",
    "tabs",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["interrupt.html", "interrupt.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_page": "settings.html"
}
